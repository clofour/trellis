Vagrant.configure("2") do |config|
    config.vm.box = "generic/debian12"

    nodes = ["control", "worker-1", "worker-2"]

    nodes.each do |name|
        config.vm.define name do |node|
            node.vm.hostname = name

            # Use Vagrant's provider-independent network abstraction. The demo
            # discovers peers through mDNS instead of relying on a host plugin
            # or provider-specific static addressing.
            node.vm.network "private_network", type: "dhcp"

            node.vm.provision "common", type: "shell", path: "demo/common.sh"
            node.vm.provision "containerd", type: "shell", path: "demo/containerd.sh"
            node.vm.provision "trellis", type: "shell", path: "demo/trellis.sh"

            # Deploy example workloads on the control node after all VMs are up.
            if name == "control"
                node.vm.provision "workloads",
                    type: "shell",
                    path: "demo/workloads.sh",
                    run: "always"
            end
        end
    end
end
