# Trellis orchestrator connection (server-side only)
TRELLIS_API_URL=http://localhost:8128
TRELLIS_API_TOKEN=your-cluster-token-here
# Namespace used to scope jobs and allocations
TRELLIS_NAMESPACE=default
# Set to "true" to enable write operations (create, edit, stop jobs) in the dashboard.
# Defaults to false (read-only). Only enable this on trusted networks.
TRELLIS_ALLOW_WRITES=false
