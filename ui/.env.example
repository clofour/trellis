# Trellis orchestrator connection (server-side only)
TRELLIS_API_URL=http://localhost:8128
TRELLIS_API_TOKEN=your-cluster-token-here
# Name shown in the dashboard context selector
TRELLIS_CLUSTER_NAME=local
# Default namespace used to scope jobs, allocations, and secrets
TRELLIS_NAMESPACE=default
# Optional comma-separated namespace allowlist. When more than one is set,
# operators can switch namespace from the dashboard context selector.
TRELLIS_NAMESPACES=default
# Set to "true" to enable dashboard mutations (job apply/edit/delete,
# node drain/undrain, and secret create/rotate/delete). Defaults to false.
# Only enable this on a trusted administration network.
TRELLIS_ALLOW_WRITES=false
