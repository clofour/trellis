worker_processes auto;
error_log /var/log/nginx/error.log warn;

events {
    worker_connections 1024;
}

http {
    access_log /var/log/nginx/access.log;

    # Health endpoint for the proxy itself.
    server {
        listen 80 default_server;
        server_name _;

        location /health {
            return 200 "ok\n";
        }

        location / {
            return 404 "no matching upstream\n";
        }
    }

    # Upstream and server blocks below are generated by sync-upstreams.sh
    # and written to /etc/nginx/conf.d/upstreams.conf.
    include /etc/nginx/conf.d/*.conf;
}
