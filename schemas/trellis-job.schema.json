{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/clofour/trellis-experimental/main/schemas/trellis-job.schema.json",
  "title": "Trellis job manifest",
  "description": "Schema for the first-party human-authored YAML representation. Trellis itself consumes canonical JSON after the consumer converts human quantities.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "namespace", "task_groups"],
  "properties": {
    "name": { "$ref": "#/$defs/identifier", "description": "Job name." },
    "namespace": { "$ref": "#/$defs/identifier", "description": "Namespace containing the job." },
    "task_groups": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/taskGroup" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,62}$"
    },
    "duration": {
      "description": "A Go-style duration such as 500ms, 10s, 1m30s, or a canonical nanosecond count.",
      "oneOf": [
        { "type": "integer", "minimum": 0 },
        { "type": "string", "pattern": "^(?:[0-9]+(?:\\.[0-9]+)?(?:ns|us|µs|μs|ms|s|m|h))+$" }
      ]
    },
    "byteSize": {
      "description": "A byte count or human-readable decimal/binary size such as 64MB or 64MiB.",
      "oneOf": [
        { "type": "integer", "minimum": 0 },
        { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?\\s*(?:[Bb]|[KkMmGgTt][Bb]?|[KkMmGgTt]i[Bb]?)?$" }
      ]
    },
    "apiAccess": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "access"],
      "properties": {
        "scope": {
          "type": "string",
          "enum": ["namespace", "cluster"],
          "description": "Where the injected credential may operate."
        },
        "access": {
          "type": "string",
          "enum": ["read", "write"],
          "description": "Whether the injected credential is read-only or may mutate state. write implies read."
        }
      }
    },
    "taskGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "count", "tasks"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "count": { "type": "integer", "minimum": 1 },
        "runtime": { "type": "string", "enum": ["runc", "runsc"] },
        "api_access": { "$ref": "#/$defs/apiAccess" },
        "labels": { "type": "object", "additionalProperties": { "type": "string", "maxLength": 256 } },
        "constraints": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["attribute", "value"],
            "properties": {
              "attribute": { "type": "string" },
              "value": { "type": "string", "minLength": 1 }
            }
          }
        },
        "restart": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_restarts", "window"],
          "properties": {
            "max_restarts": { "type": "integer", "minimum": 0 },
            "window": { "$ref": "#/$defs/duration" }
          }
        },
        "update": {
          "type": "object",
          "additionalProperties": false,
          "required": ["strategy"],
          "properties": {
            "strategy": { "type": "string", "enum": ["recreate", "rolling"] },
            "max_parallel": { "type": "integer", "minimum": 0 }
          }
        },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/task" }
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "image"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "image": { "type": "string", "minLength": 1 },
        "env": { "type": "object", "additionalProperties": { "type": "string" } },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cpu", "memory"],
          "properties": {
            "cpu": { "type": "integer", "minimum": 0, "description": "CPU request in millicores." },
            "memory": { "$ref": "#/$defs/byteSize" }
          }
        },
        "networking": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": { "type": "string", "enum": ["isolated", "host", "namespace"], "description": "isolated uses a private network namespace with no external routes; host joins the node network; namespace joins the Trellis namespace network." },
            "ports": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["port"],
                "properties": { "port": { "type": "integer", "minimum": 1, "maximum": 65535 } }
              }
            }
          }
        },
        "health_check": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": { "type": "string", "enum": ["http", "tcp", "script"] },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "path": { "type": "string" },
            "command": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "interval": { "$ref": "#/$defs/duration" },
            "timeout": { "$ref": "#/$defs/duration" },
            "threshold": { "type": "integer", "minimum": 1 }
          }
        },
        "volumes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "path"],
            "properties": {
              "name": { "$ref": "#/$defs/identifier" },
              "path": { "type": "string", "pattern": "^/" },
              "host_volume": { "$ref": "#/$defs/identifier" },
              "read_only": { "type": "boolean" }
            }
          }
        },
        "secrets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "target"],
            "properties": {
              "name": { "$ref": "#/$defs/identifier" },
              "target": { "type": "string", "enum": ["env", "file"] },
              "env": { "type": "string" },
              "path": { "type": "string" },
              "mode": { "type": "integer", "enum": [256, 384] }
            }
          }
        }
      }
    }
  }
}
